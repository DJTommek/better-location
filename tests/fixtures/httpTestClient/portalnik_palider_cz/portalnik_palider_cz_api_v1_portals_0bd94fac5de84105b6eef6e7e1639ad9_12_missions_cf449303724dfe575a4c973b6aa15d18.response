{"missions":[{"guid":"cd6a31c767fd4c08b7c4ec67ae5b9820.1c","title":"#MissionProjectDOG2018 CZE Prague 1/18","image_url":"https://lh3.googleusercontent.com/R1dwPjBLItP8Q8gfxaO95AT1SgIkx1cRpVdN9AHpRmCz7yAAboTyY0K_cu1z20_3zGVkkm_X_r3KWHF6ndE","description":"Global XFAC New Year Project to Celebrate the new Lunar/chinese New Year. Celebrate with us by walking the streets and visiting statues,parks and artwork in the new year of 2018.","author_name":null,"author_faction":null,"type":"sequential","has_details":true,"first_seen_at":"2023-05-29T16:58:03.556Z","last_seen_at":"2023-05-29T16:58:03.556Z","updated_at":"2026-11-19T22:10:10.424Z"},{"guid":"7df8fb41f68349b9ac25ce72e74c0b6a.1c","title":"#MissionProjectDOG2018 CZE Prague 2/18","image_url":"https://lh3.googleusercontent.com/VM1kq8xNcbyEcewnVDlOkyMMRdFQsm6pvY8OjYPAZUHiXgc554h5aMNjIneeIh9uDxarhxFQcUJN3solxf0","description":"Global XFAC New Year Project to Celebrate the new Lunar/chinese New Year. Celebrate with us by walking the streets and visiting statues,parks and artwork in the new year of 2018","author_name":null,"author_faction":null,"type":"sequential","has_details":true,"first_seen_at":"2023-05-29T16:58:04.289Z","last_seen_at":"2023-05-29T16:58:04.289Z","updated_at":"2026-11-19T22:10:10.434Z"},{"guid":"62ae783df9c9460d88a30a97865b1082.1c","title":"#MP In Memorian Peter Mayhew Prague 10-24","image_url":"https://lh3.googleusercontent.com/U4XHIrFc7bJ_xiz4Ber1H_rlgzS9QK-daWt5q4a8sMrCGq8FZlB6lnlpG2qDjGUXvg2ODgY2JrxHhKY1ZILn","description":"R.I.P Peter Mayhew  in Prague","author_name":null,"author_faction":null,"type":"sequential","has_details":true,"first_seen_at":"2026-05-17T00:55:24.660Z","last_seen_at":"2026-05-17T00:55:24.660Z","updated_at":"2026-11-18T01:49:05.291Z"},{"guid":"f57a3bfabaa64c3e85eee322666537fc.1c","title":"1. Staroměstské nám / Old Town square","image_url":"https://lh4.ggpht.com/mFlXEZnq1runRRdG8EJBqc00sGef5GVbIjPR1Z2opMyYAeKhaJqF8lvfMXtWHnfjP0XeVC2R5IXVa20MOaJrfg","description":"Staroměstské náměstí (lidově Staromák) je centrum Starého Města. Rozkládá se na ploše více než 9000 m². 14. října 1918 se zde konala demonstrace za vyhlášení nezávislosti na Rakousku-Uhersku.","author_name":null,"author_faction":null,"type":"sequential","has_details":true,"first_seen_at":"2026-09-04T09:34:12.108Z","last_seen_at":"2026-09-04T09:34:12.108Z","updated_at":"2026-11-20T04:31:05.659Z"},{"guid":"75f2acff77c3436b8c5eca70bb3ce8a9.1c","title":"5. Praha / Prague","image_url":"https://lh5.ggpht.com/6YOXU4AJXrLKL8uj7UVKQpE_1RlZLDknCzgRWm3SnzimFG82k4TRNIQcMSXglIxsEpZBOKgqnU1yo0JoyrY","description":"Praha je hlavní a současně největší město České republiky a 15. největší město Evropské unie. V současnosti se rozkládá na území 496 čtverečních kilometrů a má přes 1,2 milionu obyvatel.","author_name":null,"author_faction":null,"type":"sequential","has_details":true,"first_seen_at":"2026-05-17T00:57:05.405Z","last_seen_at":"2026-05-17T00:57:05.405Z","updated_at":"2026-11-20T04:31:05.722Z"},{"guid":"4cfa0c5e7c514c528e3d3dced18df0c1.1c","title":"Česká republika 15","image_url":"https://lh3.googleusercontent.com/W322dIEjo8jVVfNwuSdpIhnVzM3qsmKadyc-fYYJFR_06GsM5wGw9MtY206-8io0CDlHA0dXmaSeP386inNt","description":"Směrem k Prašné bráně.\nTowards the Powder Gate.","author_name":null,"author_faction":null,"type":"sequential","has_details":true,"first_seen_at":"2026-05-17T00:59:26.170Z","last_seen_at":"2026-05-17T00:59:26.170Z","updated_at":"2026-11-18T15:37:39.551Z"},{"guid":"901100c39a86458bbef93e1e44aa89ce.1c","title":"Christmas balls Green 12","image_url":"https://lh3.googleusercontent.com/IlSUXVAL4Fpob9-BBE1nGMrZAtUb1HHqYxL2Zqc-85KBwWwzv_2O_p0r12qhz-w1CS8-eFxeSGCJlQjNObiCOqGbWrM-kelN","description":"Vánoční procházka po Praze","author_name":null,"author_faction":null,"type":"sequential","has_details":true,"first_seen_at":"2026-01-21T20:24:07.406Z","last_seen_at":"2026-01-21T20:24:07.406Z","updated_at":"2026-11-19T17:24:08.165Z"},{"guid":"11316a58bd9c49e1bfa76d17714e52e3.1c","title":"Díky! 27 / 42","image_url":"https://lh3.googleusercontent.com/KwHRAPgVvFG_dc_WYSDQBvCq4SnXoA7a0xstsiIERGT18jUU-ZPI4eyUl9W5QwoH_k_O9DQHTQHemED-pv_dPqW51zY_4m92","description":"Tematická série 42 krátkých pěších misí centrem města se začátkem i koncem na Hlavním nádraží v celkové délce cca 10 km. Na podporu všem, kdo v této těžké době obětavě pomáhají ostatním.","author_name":null,"author_faction":null,"type":"sequential","has_details":true,"first_seen_at":"2026-05-12T07:36:37.250Z","last_seen_at":"2026-05-12T07:36:37.250Z","updated_at":"2026-11-17T22:35:44.378Z"},{"guid":"16b5791a77b14451b6f43f92c2d08b50.1c","title":"Elves in Prague 5/6","image_url":"https://lh3.googleusercontent.com/UdCWCm-KRyBrg4irr04l20w0J9Ea1dug87dZWj0Q-qZ9msEQNpTQfYEKaKx-yIvOEA4pe6qaNDrIY4LMwCrS0YgCGJUxMglc9g","description":"Take a walk through the Christmas markets in Prague and get a mosaic of elves for your profile.","author_name":null,"author_faction":null,"type":"sequential","has_details":true,"first_seen_at":"2026-05-04T16:46:29.051Z","last_seen_at":"2026-05-04T16:46:29.051Z","updated_at":"2026-11-20T12:01:05.291Z"},{"guid":"557c9696a4c244ed88851ef4af6543e5.1c","title":"I visited Prague at Christmas time ! 09-36","image_url":"https://lh3.googleusercontent.com/-gURDqUKeQrhoARrLM_bB3VSIK09oabLSavZVsjJXvFLdWhKpcwGvgy0NZtMKNm5URo0WYbr-Z7MXqvg4vGKe7PPl1MwO1KuLg","description":"Visit Prague with this banner, and see the major christmas markets of the city","author_name":null,"author_faction":null,"type":"sequential","has_details":true,"first_seen_at":"2023-01-20T10:35:16.914Z","last_seen_at":"2023-01-20T10:35:16.914Z","updated_at":"2026-11-19T17:04:46.381Z"},{"guid":"c008684f27e0473d8fea6f4e99f5fb5b.1c","title":"Karlův most (8/18)","image_url":"https://lh3.googleusercontent.com/QuJGUuuXcsYBX5j48RRjnCShK-e9fVh8WNTJkZQa4Cu9F3lzWnpzlGNrL5NoxzNgh10sK_mPgExKJLi34Kmz8Q","description":"Short walk through the center of Prague and the famous Karlův most","author_name":null,"author_faction":null,"type":"sequential","has_details":true,"first_seen_at":"2022-12-28T18:58:04.235Z","last_seen_at":"2022-12-28T18:58:04.235Z","updated_at":"2026-11-19T17:36:26.602Z"},{"guid":"0a3f101657ac441286a56b391f969e15.1c","title":"MD 2019: Prague, Old Town Square Execution","image_url":"https://lh3.googleusercontent.com/kIJMTATIQyDn5UTw9X7Y3-weF3lUDxygiEiW7YegZdyvJJ8fb-lRVd2EnjV_fxac3_U3LjhIaIqi6LDlsGw","description":"The execution of 27 Czech leaders was a brutal Habsburg response to the Bohemian Revolt in the 17th century.","author_name":null,"author_faction":null,"type":"any_order","has_details":true,"first_seen_at":"2026-05-10T18:45:02.210Z","last_seen_at":"2026-05-10T18:45:02.210Z","updated_at":"2026-11-18T00:24:58.250Z"},{"guid":"eda4096c8f074f63bd1244bd8cad286d.1c","title":"MD 2026: Prague, Prague Astronomical Clock","image_url":"https://lh3.googleusercontent.com/xO2W9PFox9CHFZM9VATv8emMtekN0KogdPVkhlA3tciWePT4e6AR4Z2tH02vJVyKA7qTMsJASQKVrnH3As3qQZNhC1_0yPfriQ","description":"The Prague Orloj is a medieval astronomical clock on Old Town Hall, famous for its hourly Apostle procession.","author_name":null,"author_faction":null,"type":"any_order","has_details":true,"first_seen_at":"2026-07-22T09:03:30.530Z","last_seen_at":"2026-07-22T09:03:30.530Z","updated_at":"2026-11-20T15:51:46.848Z"},{"guid":"355911cf0d364ddea5d98be7382729d5.1c","title":"New Year 2018 Prague 12-12","image_url":"https://lh3.googleusercontent.com/cAV2cz3WfO1fnXL90Sgs_bYBqmkObfBjDSn0FN0mtP1RDyg28r0ZMnTXZdxwtfhDW6l7t_3jU_9l8useBhk","description":"Oslavte Nový rok 2018 touto mozaikou v Praze","author_name":null,"author_faction":null,"type":"sequential","has_details":true,"first_seen_at":"2023-08-04T21:46:09.174Z","last_seen_at":"2023-08-04T21:46:09.174Z","updated_at":"2026-11-20T00:41:49.603Z"},{"guid":"8a0039b1dba74ecd904af49a6fc95131.1c","title":"Orion anomaly - Golem in Prague 25/36","image_url":"https://lh3.googleusercontent.com/u4OEuoxYC-uHB8ctpEaKTA508_3XvmosncDKQzZoJK4-7monR5Rg6qzKbRJNRmPSagKyCusdO1NSqVb12q3c64BwaDxqMLlc","description":"Help frogs with waking up the golem. Enter the mysterious streets of Old town of Prague,  and feel the tension of the Golem legend. Will you manage to repeat what rabi Löw did?","author_name":null,"author_faction":null,"type":"sequential","has_details":true,"first_seen_at":"2026-05-16T10:32:22.050Z","last_seen_at":"2026-05-16T10:32:22.050Z","updated_at":"2026-11-20T15:51:00.301Z"},{"guid":"a8293c7b7347479b8339232cc06791b8.1c","title":"ORION PRAGUE 01-36","image_url":"https://lh3.googleusercontent.com/n71mh519Qsc1RTqpWIpySWmfcU-TS7MzZpgdApuU2YjOfPpPC6DZ3rQemKly23X28q6AajslNxuApqAkmP1jQcvXMrsaJ-7CWg","description":"Wonder through Old Town. Who knows, maybe you will find The Golem.","author_name":null,"author_faction":null,"type":"sequential","has_details":true,"first_seen_at":"2026-07-15T13:31:11.118Z","last_seen_at":"2026-07-15T13:31:11.118Z","updated_at":"2026-11-20T15:53:04.366Z"},{"guid":"e9670929d74242b5842794a6d9b754da.1c","title":"Prague / Praha 16 / 24","image_url":"https://lh3.googleusercontent.com/CZT87gg2vYriQAhrXohrlK-kH9OSfHx4CKrPnG2eqiPnVKt7Uy0qdx1ylkn4O68xMEReS6O-7zJmFkHQoCs","description":"Come with us and discover Prague, capital of the  Czech Republic, also known as the City of a Hundred Spires. Learn its history and culture as you walk its streets and visiting its legendary monuments","author_name":null,"author_faction":null,"type":"sequential","has_details":true,"first_seen_at":"2022-11-28T16:17:27.576Z","last_seen_at":"2022-11-28T16:17:27.576Z","updated_at":"2026-11-19T16:42:51.416Z"},{"guid":"78c70b1cdb414e4b900b4080e01deaa7.1c","title":"Prague 6/6","image_url":"https://lh3.googleusercontent.com/6PB70jXirmRirjjAq8dpGkubgpVzXoHF9r0JzH8G59QcVOEJ1lzShRQW7mQ0Wd83apeVuDUTyk4WlcxRQW-awjDn6DdOn7tXHQ","description":"Krátká série 6 misí od Právnické fakulty na Staroměstské nám.","author_name":null,"author_faction":null,"type":"sequential","has_details":true,"first_seen_at":"2026-07-15T13:13:18.496Z","last_seen_at":"2026-07-15T13:13:18.496Z","updated_at":"2026-11-18T14:24:56.430Z"},{"guid":"5c1cdc19de0440a1a442dd3b8ac55283.1c","title":"Prague II","image_url":"https://lh5.ggpht.com/rVR0PSTUhRYaE9Lg7E3yDA9wyPqh7ZF63NHPSEyAotpklNhJP6RyAJVXYQD5G1FvbKSnW5oagyYqVxlONt4","description":"Slož si nápis.Druhá mise ze šesti.","author_name":null,"author_faction":null,"type":"sequential","has_details":true,"first_seen_at":"2026-10-07T08:47:35.283Z","last_seen_at":"2026-10-07T08:47:35.283Z","updated_at":"2026-11-18T01:53:01.595Z"},{"guid":"6bc5d03680584dd9a77a4da1c9f6b26b.1c","title":"Praha a její krásy - Beauty of Prague, část 4/24","image_url":"https://lh3.googleusercontent.com/ptj2DvYONCDP2_L5k1WIpPRRlp-dpPNyLG5YmejO5NSIYqRD1MRFPkK6rHfMQYvMJ9xrJA6bJx4QTWXiv94","description":"Poznejte krásy Prahy.  Ulicí Dušní kolem synagogy na Staroměstské náměstí.\nDiscover the beauty of Prage. Street Dušní, around the synagogue to the Old Town Square.","author_name":null,"author_faction":null,"type":"sequential","has_details":true,"first_seen_at":"2026-05-17T03:15:41.784Z","last_seen_at":"2026-05-17T03:15:41.784Z","updated_at":"2026-11-18T03:40:51.860Z"},{"guid":"da4ed27e10864c48ae86578a1cf1dd5a.1c","title":"Praha Resistance 24 /24","image_url":"https://lh3.googleusercontent.com/nEdCjbbFYAcqQlfcDx4DPJjV0qjAjPcpqg-F6fi5FjWWfOeVMGAmfqgBNm8sIffo4330a6Kw6_ICKhRB03Mg8A","description":"Resistance mosaic of Prague in Czech R.","author_name":null,"author_faction":null,"type":"sequential","has_details":true,"first_seen_at":"2026-05-17T03:16:32.632Z","last_seen_at":"2026-05-17T03:16:32.632Z","updated_at":"2026-11-18T02:37:58.513Z"},{"guid":"f3e6ff4943d743e3a34952bdc9944e04.1c","title":"Staroměstská radnice","image_url":"https://lh3.googleusercontent.com/XCfKWR_1BMZ8s9aukiSFIGZlm8RMpRhc7Hgxj028RYAvdWUfW_BteKw9NMWgZ0vmQ_8_PI7vVpsqga1HGLXP","description":"Město Praha je ověnčeno mnoha přízvisky. Mezi často používaná patří – Stověžaté město nad Vltavou. Proto byla vytvořena série o 100. misích věnovaná tomuto přízvisku.","author_name":null,"author_faction":null,"type":"any_order","has_details":true,"first_seen_at":"2026-05-10T18:45:09.882Z","last_seen_at":"2026-05-10T18:45:09.882Z","updated_at":"2026-11-20T09:06:11.020Z"},{"guid":"7f6003c0f5824eb4bd5e4b2b7d931245.1c","title":"Staroměstská radnice s orlojem (72/72)","image_url":"https://lh3.googleusercontent.com/GNNlxkwNk1jwxIQ4jzwUoXRcv3lUMe6QTH9LizVk2Hyq-L-7OUA7MQXj9BtLBgDYcXb7m8HQqpGqBmby7vAnBw","description":"Radnice v Praze byla založena roku 1338 na základě privilegia uděleného staroměstským měšťanům králem Janem Lucemburským. Tvoří ji komplex několika domů přiléhajících ke Staroměstskému náměstí.","author_name":null,"author_faction":null,"type":"sequential","has_details":true,"first_seen_at":"2026-05-17T03:24:52.180Z","last_seen_at":"2026-05-17T03:24:52.180Z","updated_at":"2026-11-17T22:37:15.208Z"},{"guid":"2375a57e678246588eee0e68a5e2a8f5.1c","title":"Svatý Václav 09/30","image_url":"https://lh3.googleusercontent.com/TKPOsgJUAk4GrS61S9isIIDSPnOH9l2kfIfFPleoW4IDArPM-QvMFrmlaGoVuOTashaN3ZQYNY5yYnW58t2Rsw","description":"Svatováclavský symbol\nSvatý Václav je jedním z nejoblíbenějších českých svatých, patron české země, mučedník, postava, jejíž tradice sehrála velmi důležitou úlohu při vzniku českého státu .","author_name":null,"author_faction":null,"type":"sequential","has_details":true,"first_seen_at":"2026-05-17T03:25:29.209Z","last_seen_at":"2026-05-17T03:25:29.209Z","updated_at":"2026-11-18T05:35:34.639Z"},{"guid":"1f2d241f0eed4f7f9f44c348b5300f3c.1c","title":"Team Rainbow goes Prague 01-12","image_url":"https://lh3.googleusercontent.com/LWgnB-2BGx0jg4c3T8mIXjGcIoCvgQzUUgtOYSviNTu1TjZyd3yr6cY0x0498Xa4jKKi70L7LlWn0cWG-YRao-PMCjzM4ax50Q","description":"Join Team Rainbow on a nice walk around Prague and discover what this beautiful city has to offer","author_name":null,"author_faction":null,"type":"sequential","has_details":true,"first_seen_at":"2026-07-15T13:00:10.931Z","last_seen_at":"2026-07-15T13:00:10.931Z","updated_at":"2026-11-20T15:53:42.154Z"},{"guid":"13ddcb6bb60e4a56a9415492b9d29ec4.1c","title":"The Legend of Golem 12 /30","image_url":"https://lh3.googleusercontent.com/asdwKJDTxlsOwZJHtzynf-jMpSg5x0WjitBXgjdqTheqgG-HXwgG0S-8U6AqmCRmAfwO0XVsWkAEEye7eJTpMYFqE8h6cjHcig","description":"A walking tour through Prague's Old Town. Follow the Golem legend through hidden corners and complete this mosaic of the magical Mother of Cities.","author_name":null,"author_faction":null,"type":"sequential","has_details":true,"first_seen_at":"2026-05-19T12:19:11.133Z","last_seen_at":"2026-05-19T12:19:11.133Z","updated_at":"2026-11-20T15:52:26.726Z"},{"guid":"3c8c5fc695a8427dba6b8dc2a5d9f8fc.1c","title":"WalkPRG 2025 ✰ Old Town Square","image_url":"https://lh3.googleusercontent.com/5t1O24LxVUwUX8iDzVbFrNeg-L-Bt2cfOngBYRHvEFsOoT7istAOKRjc7zi13fQutIKtH-YeY4AxN9Gw4D6uvlt64VBxNrOj","description":"in slang today Staromák, formerly also Velké náměstí, from the 13th century Staré tržiště, from the 14th century Staroměstský rynk, in the 18th century most often Staroměstský plac. Meet you out there","author_name":null,"author_faction":null,"type":"sequential","has_details":true,"first_seen_at":"2026-05-10T18:44:52.817Z","last_seen_at":"2026-05-10T18:44:52.817Z","updated_at":"2026-11-20T11:32:47.596Z"},{"guid":"e674baddab5e484bac443ba9c848d9ea.1c","title":"Winter Prague 28/36","image_url":"https://lh3.googleusercontent.com/s9P_-RND3rVBgnO7YOgHOjWAsuGG-XXrUi_EDW0I2KGe6Yu8DP_Gw8d_l0Dxj7DlEjy6YdPcIRD3z_OeG56dGjWVKtZjo7W4XQ","description":"Prague is the capital and largest city of the Czech Republic and the historic capital of Bohemia. Visit this beautiful city in winter!","author_name":null,"author_faction":null,"type":"sequential","has_details":true,"first_seen_at":"2026-05-17T03:32:07.184Z","last_seen_at":"2026-05-17T03:32:07.184Z","updated_at":"2026-11-20T02:51:16.170Z"}]}
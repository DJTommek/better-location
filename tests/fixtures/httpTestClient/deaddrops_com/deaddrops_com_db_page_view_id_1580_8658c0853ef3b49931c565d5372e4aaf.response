<script>
	var osmUrl = 'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
		osmAttribution = 'Map data &copy; 2011 OpenStreetMap contributors',
		osm = new L.TileLayer(osmUrl, {
			maxZoom: 18,
			attribution: osmAttribution
		});

	var map = new L.Map('map');

	var DeadDropIcon = L.Icon.extend({
		iconUrl: './images/icon/d1.png',
		iconSize: new L.Point(34, 55),
		iconAnchor: new L.Point(20, 55),
		popupAnchor: new L.Point(0, 0)
	});

	// var d1 = new DeadDropIcon();,
	// d2 = new DeadDropIcon('./images/icon/d2.png'),
	// d3 = new DeadDropIcon('./images/icon/d3.png'),
	// l3 = new DeadDropIcon('./images/icon/l3.png'),
	// l2 = new DeadDropIcon('./images/icon/l2.png'),
	// l1 = new DeadDropIcon('./images/icon/l1.png'),
	// o3 = new DeadDropIcon('./images/icon/o3.png'),
	// o2 = new DeadDropIcon('./images/icon/o2.png'),
	// o1 = new DeadDropIcon('./images/icon/o1.png'),
	// w3 = new DeadDropIcon('./images/icon/w3.png'),
	// w2 = new DeadDropIcon('./images/icon/w2.png'),
	// w1 = new DeadDropIcon('./images/icon/w1.png');

	map.setView(new L.LatLng(36.6, 89.4), 14).addLayer(osm);

	var loc = new L.LatLng(36.6, 89.4);

	var droptype = 2;

	var ddIcon = new L.Icon({
		iconUrl: './images/icon/w3.png',
		iconSize: new L.Point(34, 55),
		iconAnchor: new L.Point(20, 55),
		popupAnchor: new L.Point(0, 0)
	});

	var marker = new L.Marker(loc, {
		icon: ddIcon,
		draggable: false	});

	// if(droptype=='1'){
	//  marker = new L.Marker(loc, {icon: d1});
	//  }

	// if(droptype=='2'){
	//   marker = new L.Marker(loc, {icon: w1});
	// }

	// if(droptype=='3'){
	//   marker = new L.Marker(loc, {icon: l1});
	// }

	// if(droptype=='9'){
	//   marker = new L.Marker(loc, {icon: o1});
	// }

	map.addLayer(marker);

	marker.bindPopup('<div style="width:240px"><b>Julia</b><br>, aguaí São Paulo, BR</b></div>');

	</script>

